# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sustainability_db?schema=public"

# Google Gemini (free key: https://aistudio.google.com/apikey)
# Leave empty to run in mock mode (template-generated insights, no LLM calls).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LLM_TIMEOUT_MS=20000

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"
INSIGHT_RATE_LIMIT_PER_MIN=10
